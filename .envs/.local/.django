# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
OAI_USE_DB_ASSEMBLER=true

# MinIO Configuration
# ------------------------------------------------------------------------------
USE_MINIO=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT_URL=http://minio:9020
AWS_S3_BROWSER_ENDPOINT_URL=http://localhost:9020
AWS_INGEST_BUCKET_NAME=arkumu-ingest
AWS_PRODUCTION_BUCKET_NAME=fuk
DJANGO_ROOT_LOG_LEVEL=DEBUG
ARKUMU_PROJECTS_LOG_LEVEL=DEBUG
